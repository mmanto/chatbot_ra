# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot_ra
# Puerto de PostgreSQL expuesto en el host (cambiar si hay conflicto)
DB_HOST_PORT=5432

# ── API ─────────────────────────────────────────────────────
API_PORT=8000
# URL pública del frontend (para decidir cookies `secure`)
APP_PUBLIC_URL=http://localhost:3000

# ── Web ─────────────────────────────────────────────────────
WEB_PORT=3000

# ── Seguridad / operador ────────────────────────────────────
# Generar con: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-aleatorio-de-64-chars
# Minutos de expiración de la sesión del operador
JWT_EXPIRES_MIN=480

# Operador único del panel (email + contraseña de mínimo 8 caracteres)
OPERATOR_EMAIL=operador@example.com
OPERATOR_PASSWORD=cambiar123
